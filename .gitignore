# Local test artefacts
/.test/
/tmp/
*.swp
*.swo
.DS_Store

# Local depot / state dumps (never commit Funcom binaries)
depot/
extracted/
state/
runtime/
logs/

# ...but the `state/` and `server/` runtime-dir rules above must not hide
# the Go source packages of the same name under mock-k8s/internal.
!mock-k8s/internal/server/
!mock-k8s/internal/server/**
!mock-k8s/internal/state/
!mock-k8s/internal/state/**

# Editor
.vscode/
.idea/
scripts/mock-k8s-go
scripts/__pycache__/

# Local secrets / access notes — NEVER commit. Pelican Panel API keys,
# SFTP creds, and admin tokens for the experimental server live in
# *.local.md files (e.g. PELICAN-ACCESS.local.md) and stay on this box only.
*.local.md
